{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/northline/protocol.schema.json",
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_id", "objective"],
      "properties": {
        "mission_id": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "global_constraints": {"$ref": "#/$defs/stringArray"},
        "decisions": {"$ref": "#/$defs/stringArray"},
        "acceptance_criteria": {"$ref": "#/$defs/stringArray"},
        "root_commit": {"type": ["string", "null"]},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 2},
        "max_children": {"type": "integer", "minimum": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "parent_id", "mission_id", "version", "objective", "in_scope", "out_of_scope", "allowed_files", "forbidden_files", "acceptance_criteria", "required_tests", "base_commit"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "parent_id": {"type": "string", "minLength": 1},
        "mission_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "objective": {"type": "string", "minLength": 1},
        "in_scope": {"$ref": "#/$defs/stringArray"},
        "out_of_scope": {"$ref": "#/$defs/stringArray"},
        "allowed_files": {"$ref": "#/$defs/stringArray"},
        "forbidden_files": {"$ref": "#/$defs/stringArray"},
        "dependencies": {"$ref": "#/$defs/stringArray"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_tests": {"$ref": "#/$defs/stringArray"},
        "base_commit": {"type": "string", "minLength": 1},
        "deadline_or_budget": {"type": ["string", "null"]}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "contract_id", "contract_version", "agent_id", "status", "base_commit", "result_commit", "changed_files", "diff_summary", "tests_run", "test_results", "acceptance_evidence"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "integer", "minimum": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["reporting", "verified", "partial", "blocked", "needs_parent_decision", "stale", "rejected"]},
        "base_commit": {"type": "string", "minLength": 1},
        "result_commit": {"type": ["string", "null"]},
        "changed_files": {"$ref": "#/$defs/stringArray"},
        "diff_summary": {"type": "string"},
        "tests_run": {"$ref": "#/$defs/stringArray"},
        "test_results": {"$ref": "#/$defs/stringArray"},
        "evidence_links": {"$ref": "#/$defs/stringArray"},
        "acceptance_evidence": {"type": "object", "additionalProperties": {"type": "string"}},
        "assumptions": {"$ref": "#/$defs/stringArray"},
        "risks": {"$ref": "#/$defs/stringArray"},
        "unresolved_questions": {"$ref": "#/$defs/stringArray"},
        "recommended_next_action": {"type": ["string", "null"]}
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "contract_id", "contract_version", "agent_id", "kinds", "contract_base_commit", "workspace_merge_base", "parent_head", "blocking_evidence", "requested_changes", "alternatives", "risks", "required_tests", "requires_user_decision", "stopped_work"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "integer", "minimum": 1},
        "agent_id": {"type": "string", "minLength": 1},
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["stale_state", "scope_change", "root_constraint_conflict", "blocked"]}
        },
        "contract_base_commit": {"type": "string", "minLength": 1},
        "workspace_merge_base": {"type": "string", "minLength": 1},
        "parent_head": {"type": "string", "minLength": 1},
        "blocking_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "requested_changes": {"type": "object"},
        "alternatives": {"$ref": "#/$defs/stringArray"},
        "risks": {"$ref": "#/$defs/stringArray"},
        "required_tests": {"$ref": "#/$defs/stringArray"},
        "requires_user_decision": {"type": "boolean"},
        "stopped_work": {"const": true}
      }
    },
    "escalationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "contract_id", "approved", "rationale", "decided_by", "user_approved"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "contract_id": {"type": "string", "minLength": 1},
        "approved": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 1},
        "decided_by": {"const": "root"},
        "user_approved": {"type": "boolean"}
      }
    }
  }
}
